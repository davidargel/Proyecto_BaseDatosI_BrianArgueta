    Pais {
        INT PaisId PK
        NVARCHAR_100 Nombre
        CHAR_2 CodigoISO
    }
    Departamento {
        INT DepartamentoId PK
        INT PaisId FK
        NVARCHAR_100 Nombre
    }
    Municipio {
        INT MunicipioId PK
        INT DepartamentoId FK
        NVARCHAR_100 Nombre
    }
    Direccion {
        INT DireccionId PK
        INT MunicipioId FK
        NVARCHAR_200 Linea1
        NVARCHAR_200 Linea2
        NVARCHAR_20 CodigoPostal
    }
    Persona {
        INT PersonaId PK
